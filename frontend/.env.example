# Copy placeholders to frontend/.env.local and replace them with Clerk development values.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is public; CLERK_SECRET_KEY must remain server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
NEXT_PUBLIC_ADFORGE_API_BASE_URL=http://127.0.0.1:8000
