# Copy placeholders to a private backend environment file. These are not real keys.
# The Clerk JWT public key is verification material; never put a private signing key here.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_CLERK_RSA_PUBLIC_KEY\n-----END PUBLIC KEY-----"
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional; omit unless your Clerk session tokens use an audience claim.
# CLERK_AUDIENCE=your-api-audience

# Developer-controlled local PostgreSQL only. Copy to backend/.env and replace placeholders.
# The backend loads backend/.env; process environment variables take precedence.
DATABASE_URL=postgresql+psycopg://spotloom_local_dev_DB:replace_with_local_password@127.0.0.1:5432/spotloom_local_dev_DB

# Required for explicit asset-recovery CLI runs. The expected role is separately
# checked against PostgreSQL server metadata; it is not inferred from DATABASE_URL.
SPOTLOOM_RECOVERY_EXPECTED_DATABASE_ROLE=spotloom_local_dev_DB

# Optional local-only asset adapter configuration. Set an absolute private directory
# outside this repository and every web-served directory before constructing the adapter.
# There is deliberately no repository-local default. Production storage remains undecided.
# SPOTLOOM_ASSET_STORAGE_ROOT=

# Required only for an explicit asset-recovery CLI invocation; choose a positive
# integer according to the approved upload-intent policy. There is no default.
# SPOTLOOM_MAX_UPLOAD_INTENT_LIFETIME_SECONDS=
